{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/notify.sh",
            "args": ["claude", "permission"],
            "timeout": 5,
            "statusMessage": "Sending approval notification"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/notify.sh",
            "args": ["claude", "stop"],
            "timeout": 5,
            "statusMessage": "Sending completion notification"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/rust-format-lint.sh",
            "args": [],
            "timeout": 300,
            "statusMessage": "Running Rust format and lint"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/swift-format-lint.sh",
            "args": [],
            "timeout": 300,
            "statusMessage": "Running Swift format and lint"
          }
        ]
      }
    ]
  }
}
