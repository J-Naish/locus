{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/notify.sh",
            "args": ["claude", "permission"],
            "timeout": 5,
            "statusMessage": "Sending approval notification"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/notify.sh",
            "args": ["claude", "stop"],
            "timeout": 5,
            "statusMessage": "Sending completion notification"
          }
        ]
      }
    ]
  }
}
